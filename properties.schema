{
  "type": "object",
  "$schema": "http://json-schema.org/draft-03/schema",
  "id": "http://jsonschema.net",
  "properties": {
    "pluginLocations": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "_gtag": {
              "type": "object",
              "legend": "Google Analytics 4",
              "properties": {
                "_isEnabled": {
                  "type": "boolean",
                  "default": false,
                  "title": "Is enabled",
                  "inputType": "Checkbox",
                  "help": "Enable Google Analytics tracking"
                },
                "_measurementId": {
                  "type": "string",
                  "required": true,
                  "title": "Tag Manager container ID",
                  "inputType": "Text",
                  "validators": [
                    "required"
                  ],
                  "help": "The Google Tag Manager container ID, starting with GTM- (for example GTM-XXXXXXX)"
                },
                "_injectSnippets": {
                  "type": "boolean",
                  "default": true,
                  "title": "Add the Tag Manager snippet",
                  "inputType": "Checkbox",
                  "help": "Turn off only if the page hosting the course already loads this Tag Manager container"
                },
                "_debug": {
                  "type": "boolean",
                  "default": false,
                  "title": "Debug logging",
                  "inputType": "Checkbox",
                  "help": "Log every event sent to Tag Manager in the browser console. Leave off for published courses"
                }
              }
            }
          }
        }
      }
    }
  }
}
